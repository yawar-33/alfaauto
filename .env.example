# Public site URL (no trailing slash). Used for canonicals, Open Graph, sitemap and schema.
NEXT_PUBLIC_SITE_URL=https://alfaauto.com.au

# Booking emails via Resend (https://resend.com). Without these, bookings are logged only.
RESEND_API_KEY=
BOOKING_TO_EMAIL=bookings@alfaauto.com.au
BOOKING_FROM_EMAIL=Alfa Website <website@alfaauto.com.au>

# Google Search Console HTML-tag token (the content="..." value only). Tag is omitted when empty.
GOOGLE_SITE_VERIFICATION=

# Workshop coordinates from Google Maps, e.g. -37.9xxx and 145.0xxx. Geo schema is added only when both are set.
NEXT_PUBLIC_GEO_LAT=
NEXT_PUBLIC_GEO_LNG=
